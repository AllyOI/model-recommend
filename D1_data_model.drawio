<mxfile host="app.diagrams.net"><diagram name="D1 Data Model" id="d1-er"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1100" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="er_Client" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:13px;background:#dbe9f7;border-bottom:1px solid #2b6cb0;padding:3px;&quot;&gt;Client&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;PK&amp;nbsp;&lt;/span&gt;client_id &lt;span style=&quot;color:#666666;&quot;&gt;uuid&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;&amp;nbsp;&lt;/span&gt;name &lt;span style=&quot;color:#666666;&quot;&gt;text&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;strokeColor=#2b6cb0;fillColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="70" as="geometry"/></mxCell><mxCell id="er_VendorApproval" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:13px;background:#dbe9f7;border-bottom:1px solid #2b6cb0;padding:3px;&quot;&gt;VendorApproval&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;PK,FK&amp;nbsp;&lt;/span&gt;client_id &lt;span style=&quot;color:#666666;&quot;&gt;uuid&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;PK,FK&amp;nbsp;&lt;/span&gt;vendor_id &lt;span style=&quot;color:#666666;&quot;&gt;uuid&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;&amp;nbsp;&lt;/span&gt;approved_at &lt;span style=&quot;color:#666666;&quot;&gt;timestamptz&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;idx&amp;nbsp;&lt;/span&gt;expires_at &lt;span style=&quot;color:#666666;&quot;&gt;timestamptz, nullable&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;strokeColor=#2b6cb0;fillColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="425" y="70" width="250" height="106" as="geometry"/></mxCell><mxCell id="er_Vendor" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:13px;background:#dbe9f7;border-bottom:1px solid #2b6cb0;padding:3px;&quot;&gt;Vendor&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;PK&amp;nbsp;&lt;/span&gt;vendor_id &lt;span style=&quot;color:#666666;&quot;&gt;uuid&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;&amp;nbsp;&lt;/span&gt;name &lt;span style=&quot;color:#666666;&quot;&gt;text&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;&amp;nbsp;&lt;/span&gt;retention_policy_url &lt;span style=&quot;color:#666666;&quot;&gt;text&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;strokeColor=#2b6cb0;fillColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="810" y="70" width="250" height="88" as="geometry"/></mxCell><mxCell id="er_Report" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:13px;background:#dbe9f7;border-bottom:1px solid #2b6cb0;padding:3px;&quot;&gt;Report&lt;/div&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;&lt;span style=&quot;color:#b03a2e;font-weight:bold;&quot;&gt;PK&amp;nbsp;&lt;/span&gt;report_id &lt;span style=&quot;color:#666666;&quot;&gt;uuid&lt;/span&gt;