<mxCell id="er_e4_c0" value="0..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#b03a2e;labelBackgroundColor=none;" vertex="1" connectable="0" parent="er_e4"><mxGeometry x="-0.78" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="er_e4_c1" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#b03a2e;labelBackgroundColor=none;" vertex="1" connectable="0" parent="er_e4"><mxGeometry x="0.78" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="er_e5" value="offers" style="endArrow=ERoneToMany;startArrow=ERmandOne;endFill=0;startFill=0;html=1;rounded=0;strokeWidth=1.5;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;" edge="1" parent="1" source="er_Vendor" target="er_Model"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="er_e5_c0" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#b03a2e;labelBackgroundColor=none;" vertex="1" connectable="0" parent="er_e5"><mxGeometry x="-0.78" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="er_e5_c1" value="1..N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;fontColor=#b03a2e;labelBackgroundColor=none;" vertex="1" connectable="0" parent="er_e5"><mxGeometry x="0.78" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="er_title" value="&lt;b&gt;D1 — Data Model (Report Store database)&lt;/b&gt;&lt;br&gt;Model Recommend (Concentrate AI)" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1020" height="40" as="geometry"/></mxCell><mxCell id="er_legend" value="&lt;b&gt;Conventions.&lt;/b&gt; Each box is an entity (a table in PostgreSQL). Rows list only the attributes that drive behavior: &lt;b&gt;PK&lt;/b&gt; = primary key (composite when on two rows), &lt;b&gt;FK&lt;/b&gt; = foreign key, &lt;b&gt;idx&lt;/b&gt; = indexed column. A line is a relationship, read in the direction of its label. Line ends use crow&#x27;s-foot notation, repeated as text: &lt;b&gt;1&lt;/b&gt; = exactly one (double bar), &lt;b&gt;0..N&lt;/b&gt; = zero or many (circle and fork), &lt;b&gt;1..N&lt;/b&gt; = one or many (bar and fork). The text label sits at the end of the entity it describes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;strokeColor=#999999;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1020" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>